// Copy this file to Config.local.xcconfig for machine-local client config
// overrides. Config.local.xcconfig is ignored by git.
//
// Public client values in this file are embedded in local app builds. Do not
// put backend-only secrets such as GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY
// here.
//
// TestFlight/App Store export should use a RevenueCat production iOS key.
// Release archives warn when they still use a test_ key; placeholder values
// such as appl_... are blocked when supplied as a release override.
//
// REVENUECAT_API_KEY = appl_replace_with_revenuecat_ios_public_sdk_key
