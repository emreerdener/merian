// Signing.xcconfig
// Tracked in git — shared signing indirection only.
// Personal Apple team IDs belong in Signing.local.xcconfig, which is ignored by git.
// Copy Signing.local.example.xcconfig to Signing.local.xcconfig and set
// MERIAN_DEVELOPMENT_TEAM to your own Team ID.

MERIAN_DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"

DEVELOPMENT_TEAM = $(MERIAN_DEVELOPMENT_TEAM)
