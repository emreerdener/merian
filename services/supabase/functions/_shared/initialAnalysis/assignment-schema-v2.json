{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "candidate_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "route": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "identify-describe",
        "identify-multimodal"
      ]
    },
    "operation": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "scan_identification"
      ]
    },
    "effective_plan": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "free",
        "pro_trial",
        "pro_paid",
        "pro_complimentary"
      ]
    },
    "effective_tier": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "free",
        "pro"
      ]
    },
    "flash_fallback_used": {
      "type": "boolean"
    },
    "quota_model": {
      "type": "string",
      "max_bytes": 128
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "gemini",
        "openai"
      ]
    },
    "binding": {
      "type": "string",
      "max_bytes": 128
    },
    "processor_permission": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "google_gemini",
        "openai"
      ]
    },
    "input_profile": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "description_compat_v1",
        "multimodal_text_v1"
      ]
    },
    "provider_model": {
      "type": "string",
      "max_bytes": 128,
      "nullable": true
    },
    "effective_model": {
      "type": "string",
      "max_bytes": 128
    },
    "minimum_client_protocol": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "accepted_client_protocol": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3
    },
    "minimum_identification_protocol": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "accepted_identification_protocol": {
      "type": "integer",
      "minimum": 6,
      "maximum": 6
    },
    "asset_manifest_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "retention_owner": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "initial_engine_release_archive"
      ]
    },
    "resolver_id": {
      "type": "string",
      "max_bytes": 128,
      "enum": [
        "git_blob_sha256_v1"
      ]
    },
    "preparation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "max_bytes": 128,
          "enum": [
            "none"
          ]
        },
        "profile": {
          "type": "string",
          "max_bytes": 0,
          "enum": [],
          "nullable": true
        },
        "options": {
          "type": "string",
          "max_bytes": 0,
          "enum": [],
          "nullable": true
        }
      }
    },
    "experiment": {
      "type": "string",
      "max_bytes": 0,
      "enum": [],
      "nullable": true
    }
  }
}
