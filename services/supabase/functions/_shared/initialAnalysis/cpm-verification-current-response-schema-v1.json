{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "outcome": {
      "type": "string",
      "max_bytes": 7,
      "enum": [
        "current"
      ]
    },
    "authority": {
      "type": "string",
      "max_bytes": 4,
      "enum": [
        "none"
      ]
    },
    "owner_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scan_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignment_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "snapshot_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
