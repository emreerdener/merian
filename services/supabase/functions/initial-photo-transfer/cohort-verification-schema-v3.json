{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3
    },
    "scan_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignment_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "allocation_created_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8639999998200000
    },
    "allocation_expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8640000000000000
    },
    "action": {
      "type": "string",
      "max_bytes": 13,
      "enum": [
        "verify_cohort"
      ]
    },
    "candidate_canonical": {
      "type": "string",
      "max_bytes": 1048576
    },
    "backend_generation": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "backend_configuration_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
