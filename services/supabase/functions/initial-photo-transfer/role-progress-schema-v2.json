{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2
    },
    "scan_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignment_digest": {
      "type": "string",
      "max_bytes": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "object_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "allocation_created_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8639999998200000
    },
    "allocation_expires_at_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8640000000000000
    },
    "action": {
      "type": "string",
      "max_bytes": 13,
      "enum": [
        "role_progress"
      ]
    },
    "attempt_id": {
      "type": "string",
      "max_bytes": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
