# Public-web Vercel allowlist. Do not copy GitHub deployment or database secrets.
# SUPABASE_URL is the HTTPS project API endpoint, not SUPABASE_DB_URL.
SUPABASE_URL=
# Prefer a current sb_secret_... key. SUPABASE_SERVICE_ROLE_KEY is a
# migration-only fallback for projects that have not completed key rotation.
SUPABASE_SERVER_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
WAITLIST_IP_HASH_SECRET=
WAITLIST_TRUSTED_IP_HEADER=x-vercel-forwarded-for
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=naturebook.earth

NEXT_PUBLIC_SITE_URL=https://naturebook.earth
NEXT_PUBLIC_SUPPORT_EMAIL=support@naturebook.earth
# Set after the listing is public; use the reviewed App Store Connect campaign link.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
