{
  "Rules": [
    {
      "ID": "Abort incomplete multipart uploads after 7 days",
      "Status": "Enabled",
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    },
    {
      "ID": "Purge quarantine objects after 1 day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "quarantine/"
      },
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "Purge export objects after 1 day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "exports/"
      },
      "Expiration": {
        "Days": 1
      }
    },
    {
      "ID": "Purge staging objects after 1 day",
      "Status": "Enabled",
      "Filter": {
        "Prefix": "staging/"
      },
      "Expiration": {
        "Days": 1
      }
    }
  ]
}
