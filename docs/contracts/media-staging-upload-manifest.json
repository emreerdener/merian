{
  "schemaVersion": 6,
  "endpoint": "/generate-upload-urls",
  "requestBodyMustBeObject": true,
  "legacyTopLevelArraysAccepted": false,
  "missingSizeErrorCode": "size_bytes_required",
  "maxFilesPerRequest": 6,
  "minFileBytes": 1,
  "maxImageBytes": 5242880,
  "maxImageFiles": 5,
  "maxAudioBytes": 2700000,
  "maxAudioFiles": 2,
  "maxVideoBytes": 12582912,
  "maxVideoFiles": 1,
  "imageContentTypes": [
    "image/webp",
    "image/jpeg",
    "image/png",
    "image/heic",
    "image/heif"
  ],
  "audioContentTypes": [
    "audio/wav",
    "audio/mp4"
  ],
  "inferenceAudioContentTypes": [
    "audio/wav"
  ],
  "scanShareRestoreAudioContentTypes": [
    "audio/wav",
    "audio/mp4"
  ],
  "videoContentTypes": [
    "video/mp4"
  ],
  "canonicalQueuedImageContentType": "image/webp",
  "canonicalQueuedWavContentType": "audio/wav",
  "canonicalScanShareRestoreM4AContentType": "audio/mp4",
  "canonicalInferenceAudioContentType": "audio/wav",
  "audioFileExtensionsByContentType": {
    "audio/wav": [
      "wav"
    ],
    "audio/mp4": [
      "m4a"
    ]
  },
  "canonicalQueuedVideoContentType": "video/mp4",
  "optionalRequestFields": [
    "clientScanId",
    "mediaRole",
    "uploadPurpose"
  ],
  "requiredPerFileFields": [
    "fileName",
    "mediaKind",
    "contentType",
    "sizeBytes"
  ],
  "uploadPurposes": [
    "scan_share_restore"
  ],
  "optionalResponseFields": [
    "mediaAssetId",
    "mediaSessionId"
  ],
  "requiredResponseFields": [
    "fileName",
    "signedUrl",
    "objectKey",
    "requiredHeaders"
  ],
  "requiredSignedHeaders": [
    "Content-Type",
    "Content-Length"
  ],
  "signedHeaderSet": "content-length;content-type;host",
  "mediaRolesByKind": {
    "image": [
      "display",
      "thumbnail",
      "inference_frame"
    ],
    "audio": [
      "audio"
    ],
    "video": [
      "playback"
    ]
  },
  "fileNameSafeCharacterPattern": "^[A-Za-z0-9_.-]+$",
  "fileNamesMustBeUnique": true,
  "legacyFileNamesAccepted": false
}
