{
  "schemaVersion": 3,
  "endpoint": "/generate-upload-urls",
  "maxFilesPerRequest": 6,
  "maxImageBytes": 5242880,
  "maxImageFiles": 5,
  "maxAudioBytes": 2700000,
  "maxAudioFiles": 2,
  "maxVideoBytes": 12582912,
  "maxVideoFiles": 1,
  "imageContentTypes": [
    "image/webp",
    "image/jpeg",
    "image/png",
    "image/heic",
    "image/heif"
  ],
  "audioContentTypes": [
    "audio/wav",
    "audio/mp4"
  ],
  "videoContentTypes": [
    "video/mp4"
  ],
  "canonicalQueuedImageContentType": "image/webp",
  "canonicalQueuedWavContentType": "audio/wav",
  "canonicalQueuedM4AContentType": "audio/mp4",
  "canonicalQueuedVideoContentType": "video/mp4",
  "optionalRequestFields": [
    "clientScanId",
    "mediaRole",
    "uploadPurpose"
  ],
  "uploadPurposes": [
    "scan_share_restore"
  ],
  "optionalResponseFields": [
    "mediaAssetId",
    "mediaSessionId"
  ],
  "mediaRolesByKind": {
    "image": [
      "display",
      "thumbnail",
      "inference_frame"
    ],
    "audio": [
      "audio"
    ],
    "video": [
      "playback"
    ]
  },
  "fileNameSafeCharacterPattern": "^[A-Za-z0-9_.-]+$",
  "fileNamesMustBeUnique": true,
  "legacyFileNamesAccepted": true
}
