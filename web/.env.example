# Public site URL used for canonical links and Open Graph previews.
NEXT_PUBLIC_SITE_URL=https://merian.earth

# Optional public CTA target.
NEXT_PUBLIC_APP_STORE_URL=

# Public support contact shown on legal/support pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@merian.earth

# Supabase project config.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback for local public reads if the RPC/table policies permit anon access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional UUID used as the viewer id for public Explore RPCs.
# Leave blank unless you decide to provision a dedicated public-web viewer identity.
SUPABASE_PUBLIC_VIEWER_ID=
